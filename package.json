{
  "name": "money-line",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MONEY LINE — a railroad, mining and terrain-engineering simulation. Dig Deep. Lay Track. Strike Rich.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
