  {"id": "mid-play", "name": "The valley on day one", "kind": "play", "steps": [{"click": "New Venture"}],
   "wait_for": {"js": "!!window.__ml && window.__ml.state.tick > 4", "timeout_ms": 15000}},
  {"id": "railhead", "name": "Crews laying the line", "kind": "moment", "moment": "railhead",
